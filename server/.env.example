APP_ENV=development
APP_PORT=8080

DATABASE_URL=postgres://tutorpilot:tutorpilot@localhost:5432/tutorpilot?sslmode=disable

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

PASSWORD_PEPPER=change-me-to-a-long-random-pepper

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="TutorPilot <no-reply@tutorpilot.com>"

OTP_TTL=10m
APP_VERIFY_URL=http://localhost:8080/verify-email


MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tutorpilot
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_USE_SSL=false

LIVEKIT_URL="http://localhost:7880"
LIVEKIT_API_KEY="tutorpilot"
LIVEKIT_API_SECRET="sdfsfd4f7c2d9a1b8e5f6a3c7d9e2f4b6a8c1ddfsafdsadf"
# --- Eventing (outbox -> Redis Streams -> notification worker) ---------------
# The relay lives in the API process because it reads that service's own outbox.
# Set false to move it to a dedicated process later without a code change.
RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100

# Two streams so bulk batch mail cannot delay a login code.
EVENT_STREAM_NOTIFICATIONS=tutorpilot:events:notifications
EVENT_STREAM_AUTH=tutorpilot:events:auth
EVENT_CONSUMER_GROUP=notification-workers

# Retention doubles as the worker-outage budget: MINID trimming removes stream
# entries even when they are pending-unacked, so an outage longer than this
# loses events without dead-lettering them. Enforced >= 1m at startup.
EVENT_RETENTION_NOTIFICATIONS=24h
EVENT_RETENTION_AUTH=1h

WORKER_CONCURRENCY=4
WORKER_MAX_ATTEMPTS=5
WORKER_CLAIM_MIN_IDLE=5m
WORKER_PORT=8081

# MUST stay below WORKER_CLAIM_MIN_IDLE/2 -- a send outlasting the reclaim
# window lets a second worker claim the same message and deliver it twice.
# config.Load fails startup if this is violated.
SMTP_TIMEOUT=10s

# Address put in invitation emails (members sign in with a temporary password).
APP_SIGN_IN_URL=http://localhost:3000/login

# CSV import holds locks per row; cap the batch.
IMPORT_MAX_ROWS=1000
